# Example Environment Configuration
# Copy this file to .env.production and update with your values

# Backend API URL
# REACT_APP_BACKEND_URL=http://localhost:9001
# VITE_APP_BACKEND_URL=http://192.168.1.30:9001
# REACT_APP_BACKEND_URL=http://0.0.0.0:9001
# VITE_APP_BACKEND_URL=http://192.168.1.30:9001
VITE_APP_BACKEND_URL=http://localhost:9001

# Disable development features in production
VITE_APP_ENABLE_VISUAL_EDITS=false
VITE_ENABLE_HEALTH_CHECK=false

# Environment
VITE_NODE_ENV=production
